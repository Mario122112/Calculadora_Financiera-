{
  "name": "calculadora-financiera",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de calculadoras financieras para trabajadores",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "start:web": "npm --workspace apps/web start",
    "build:web": "npm --workspace apps/web run build",
    "test:web": "npm --workspace apps/web test"
  },
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11.0.0"
  }
}
